// 应用题教练 · Cloudflare Worker(静态站 + /api)
// 部署步骤见 docs/DEPLOY.md
{
  "name": "word-problem-coach",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "FAMILY", "class_name": "FamilyStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FamilyStore"] }],
  "vars": {
    // Cloudflare Access 团队域名(与 mini2.kailorik.com 同一个团队)
    "TEAM_DOMAIN": "divine-wave-23a0.cloudflareaccess.com",
    // Access 应用的 AUD 标签(Zero Trust → Access → Applications → 本应用 → Overview);不填 = 接口全部拒绝
    "ACCESS_AUD": "",
    // 可选:只允许这些邮箱(逗号分隔);留空 = 交给 Access 策略决定
    "ALLOWED_EMAILS": "",
    "AI_DAILY_LIMIT": "300",
    "DEEPSEEK_MODEL": "deepseek-chat"
  },
  "observability": { "enabled": true }
}
